#!/usr/bin/env python3
"""Pólya terminal helper (stdlib only).

Talks to the running API on :8000; when the server is down, `status`, `due` and `graph` read harness.db directly.

  ./polya status            mastery, Bjork window, hypercorrections, calibration (Murphy decomposition)
  ./polya due [-n N]        FSRS due list at desired retention 0.90
  ./polya graph             hypergraph grouped by logical depth
  ./polya queue             interleaved practice priority queue
  ./polya sessions          recent sessions
  ./polya eval              how well the learner model predicts your answers; difficulty target
  ./polya scratch [show|edit|watch|path]
  ./polya chatgpt-login     open the ChatGPT browser engine's window to sign in (where that engine is installed)
"""
from __future__ import annotations

import json
import os
import sqlite3
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def env(name: str, default=None):
    """POLYA_<name>, falling back to the pre-rename LEARNHARNESS_<name>."""
    return os.environ.get(f"POLYA_{name}", os.environ.get(f"LEARNHARNESS_{name}", default))


_default_home = Path.home() / "Polya"
if not _default_home.exists() and (Path.home() / "LearnHarness").is_dir():
    _default_home = Path.home() / "LearnHarness"   # not migrated yet (first app/server start moves it)
HOME = Path(env("HOME", _default_home))
DB = Path(env("DB", HOME / "harness.db"))
SCRATCH = Path(env("WORKSPACE", HOME / "workspace")) / "scratch.tex"


def _api_base() -> str:
    """./start.sh serves on POLYA_API_PORT (8000); the Mac app writes its random port to ~/Polya/.port."""
    if env("API_PORT"):
        return f"http://127.0.0.1:{env('API_PORT')}"
    port_file = HOME / ".port"
    for port in ([port_file.read_text().strip()] if port_file.exists() else []) + ["8000"]:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=0.5):
                return f"http://127.0.0.1:{port}"
        except (urllib.error.URLError, TimeoutError, ConnectionError, ValueError):
            continue
    return "http://127.0.0.1:8000"


API = _api_base()
TTY = sys.stdout.isatty()


def c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if TTY else s


def api(path: str):
    try:
        with urllib.request.urlopen(API + path, timeout=3) as r:
            return json.loads(r.read())
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        return None


def bar(p: float, width: int = 20) -> str:
    n = max(0, min(width, round(p * width)))
    col = "31" if p < 0.35 else "33" if p < 0.85 else "32"
    return c(col, "█" * n) + c("2", "·" * (width - n))


# --- offline fallback (same formulas as backend/cognitive_math.py) ---
def _r(days: float, s: float) -> float:
    return (1 + 19 / 81 * max(0.0, days) / max(s, 0.05)) ** -0.5


def offline_nodes() -> list[dict]:
    if not DB.exists():
        sys.exit("No server on :8000 and no harness.db yet — run ./start.sh first.")
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    now = datetime.now(timezone.utc)
    out = []
    for r in conn.execute("SELECT * FROM nodes ORDER BY logical_depth, id"):
        d = dict(r)
        last = datetime.fromisoformat(d["last_reviewed_at"])
        days = (now - last).total_seconds() / 86400
        d["retrievability"] = _r(days, d["fsrs_stability"])
        d["in_bjork_window"] = 0.70 <= d["retrievability"] <= 0.85
        interval = 81 / 19 * max(d["fsrs_stability"], 0.05) * (0.9 ** -2 - 1)
        d["days_until_due"] = interval - days
        out.append(d)
    return out


def cmd_status(_args: list[str]) -> None:
    s = api("/api/stats")
    if s:
        cal = s["calibration"]
        print(c("1", "Pólya status") + c("2", f"  · engine {s['llm_engine']}"))
        print(f"  nodes {s['total_nodes']}  hyperedges {s['total_hyperedges']}  mean P(L) {s['mean_mastery']:.2f} {bar(s['mean_mastery'])}")
        print(f"  {c('36', 'Bjork window')} (R∈[0.70,0.85]) {s['bjork_window_count']}   {c('31', 'hypercorrection flags')} {s['hypercorrection_count']}   due now {s['due_count']}")
        if cal["n"]:
            print(f"  calibration n={cal['n']}  Brier {cal['mean_brier']:.3f} = REL {cal['reliability']:.3f} − RES {cal['resolution']:.3f} + UNC {cal['uncertainty']:.3f}"
                  f"  → {cal['label']} (conf {cal['mean_confidence']:.2f} vs acc {cal['accuracy']:.2f})")
        else:
            print("  calibration: no assessed answers yet")
        return
    nodes = offline_nodes()
    learn = [n for n in nodes if n["node_type"] != "BUGGY_RULE"]
    mm = sum(n["bkt_p_mastery"] for n in learn) / max(1, len(learn))
    print(c("1", "Pólya status") + c("2", "  · offline (reading harness.db)"))
    print(f"  nodes {len(nodes)}  mean P(L) {mm:.2f} {bar(mm)}")
    print(f"  Bjork window {sum(n['in_bjork_window'] for n in learn)}   hypercorrection flags {sum(n['hypercorrection_flag'] for n in nodes)}"
          f"   due now {sum(n['days_until_due'] <= 0 for n in learn)}")


def cmd_due(args: list[str]) -> None:
    n = int(args[args.index("-n") + 1]) if "-n" in args else 12
    rows = api("/api/due")
    if rows is None:
        rows = sorted(({"title": x["title"], "retrievability": x["retrievability"], "stability": x["fsrs_stability"],
                        "days_until_due": x["days_until_due"]} for x in offline_nodes() if x["node_type"] != "BUGGY_RULE"),
                      key=lambda r: r["days_until_due"])
    print(c("1", f"{'due in':>9}  {'R(t)':>5}  {'S (d)':>6}  node"))
    for r in rows[:n]:
        d = r["days_until_due"]
        when = c("31", f"{-d:6.1f}d ago") if d <= 0 else f"{d:7.1f}d  "
        win = c("36", "◆") if 0.70 <= r["retrievability"] <= 0.85 else " "
        print(f"{when} {r['retrievability']:5.2f}  {r['stability']:6.1f} {win} {r['title']}")


def cmd_graph(_args: list[str]) -> None:
    g = api("/api/graph")
    nodes = g["nodes"] if g else offline_nodes()
    edges = g["hyperedges"] if g else []
    by_depth: dict[int, list[dict]] = {}
    for n in nodes:
        by_depth.setdefault(n["logical_depth"], []).append(n)
    sym = {"AXIOM": "■", "PROPOSITION": "●", "MOVE": "▶", "COUNTEREXAMPLE": "✕", "INTUITION": "◇", "BUGGY_RULE": "☠"}
    for depth in sorted(by_depth, reverse=True):
        print(c("1", f"depth {depth}"))
        for n in by_depth[depth]:
            flag = c("31", " ⚑") if n["hypercorrection_flag"] else ""
            print(f"  {sym.get(n['node_type'], '?')} {bar(n['bkt_p_mastery'], 10)} {n['bkt_p_mastery']:.2f}  {n['title']}{flag}"
                  + c("2", f"  [{n['id']}]"))
    if edges:
        counts: dict[str, int] = {}
        for e in edges:
            counts[e["edge_type"]] = counts.get(e["edge_type"], 0) + 1
        print(c("2", "hyperedges: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items()))))


def cmd_queue(_args: list[str]) -> None:
    q = api("/api/practice/queue")
    if q is None:
        sys.exit("queue needs the running server (./start.sh)")
    for i, r in enumerate(q, 1):
        print(f"{i:2}. {r['score']:.3f}  R={r['retrievability']:.2f}  {r['title']}" + c("2", f"  ({r['domain_cluster']})"))


def cmd_sessions(_args: list[str]) -> None:
    s = api("/api/sessions")
    if s is None:
        sys.exit("sessions needs the running server (./start.sh)")
    for x in s[:15]:
        print(f"{x['status']:<10} {x['mode']:<18} Δ={x['step_velocity_delta']:.1f}  step {x['current_step_index']:<3} {x['title']}")


def cmd_eval(_args: list[str]) -> None:
    sys.path.insert(0, str(ROOT))
    from backend import model_eval   # stdlib + cognitive_math only

    sb = api("/api/model-eval")
    if sb is None:
        if not DB.exists():
            sys.exit("No server running and no harness.db yet — run ./start.sh first.")
        conn = sqlite3.connect(DB)
        has_table = conn.execute("SELECT 1 FROM sqlite_master WHERE name='model_predictions'").fetchone()
        try:
            target = json.loads((HOME / "prefs.json").read_text()).get("target_success", 0.85)
        except (OSError, ValueError):
            target = 0.85
        if not has_table:
            conn.execute("CREATE TEMP TABLE model_predictions (p_combined REAL, p_bkt REAL, p_memory REAL,"
                         " p_node_baseline REAL, p_global_baseline REAL, y INTEGER, success INTEGER)")
        sb = model_eval.scoreboard(conn, target if target in (0.80, 0.85, 0.90) else 0.85)
    text = model_eval.format_text(sb)
    head, _, rest = text.partition("\n")
    print(c("1", head) + ("\n" + rest if rest else ""))


def cmd_scratch(args: list[str]) -> None:
    sub = args[0] if args else "show"
    if sub == "path":
        print(SCRATCH)
    elif sub == "edit":
        editor = os.environ.get("EDITOR", "nvim")
        os.execvp(editor, [editor, str(SCRATCH)])
    elif sub == "watch":
        print(c("2", f"watching {SCRATCH} (Ctrl+C to stop)"))
        last = None
        while True:
            m = SCRATCH.stat().st_mtime if SCRATCH.exists() else None
            if m != last:
                last = m
                print(c("32", f"── saved {time.strftime('%H:%M:%S')} ──"))
                print(SCRATCH.read_text() if SCRATCH.exists() else "")
            time.sleep(0.5)
    else:
        print(SCRATCH.read_text() if SCRATCH.exists() else "(empty)")


def cmd_chatgpt_login(_args: list[str]) -> None:
    req = urllib.request.Request(API + "/api/engines/chatgpt-browser/login", method="POST", data=b"")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(json.loads(r.read()).get("message", ""))
    except urllib.error.HTTPError as e:
        print(json.loads(e.read() or b"{}").get("detail", f"HTTP {e.code}"))
        sys.exit(1)
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        print("Pólya is not running. Open the app (or ./start.sh) first.")
        sys.exit(1)


COMMANDS = {"status": cmd_status, "due": cmd_due, "graph": cmd_graph, "queue": cmd_queue, "sessions": cmd_sessions,
            "eval": cmd_eval, "scratch": cmd_scratch, "chatgpt-login": cmd_chatgpt_login}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 else 2)
    try:
        COMMANDS[sys.argv[1]](sys.argv[2:])
    except KeyboardInterrupt:
        pass
